<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.hibernate.org/xsd/orm/mapping
                                     https://hibernate.org/xsd/orm/mapping/mapping-3.1.0.xsd">
    <access>FIELD</access>

    <entity class="hanieum.conik.domain.proposal.domain.entity.Proposal" access="FIELD">
        <table name="proposal"/>
        <attributes>
            <basic name="projectId">
                <column name="project_id" />
            </basic>
            <basic name="companyId">
                <column name="company_id" nullable="false"/>
            </basic>
            <basic name="totalPrice">
                <column name="total_price" />
            </basic>
            <basic name="firstPrice">
                <column name="first_price"/>
            </basic>
            <basic name="secondPrice">
                <column name="second_price"/>
            </basic>
            <basic name="proposalNote">
                <column name="proposal_note"/>
            </basic>
            <basic name="submitStatus">
                <column name="submit_status"/>
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="proposalBidStatus">
                <column name="proposal_bid_status"/>
                <enumerated>STRING</enumerated>
            </basic>
            <one-to-many name="items" mapped-by="proposal" orphan-removal="true">
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-many>
            <one-to-many name="drawingFiles" mapped-by="proposal" orphan-removal="true">
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-many>
        </attributes>
    </entity>
</entity-mappings>