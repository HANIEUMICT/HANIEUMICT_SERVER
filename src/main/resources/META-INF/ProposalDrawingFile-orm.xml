<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.hibernate.org/xsd/orm/mapping
                                     https://hibernate.org/xsd/orm/mapping/mapping-3.1.0.xsd">
    <access>FIELD</access>

    <entity class="hanieum.conik.domain.proposal.domain.entity.ProposalDrawingFile" access="FIELD">
        <table name="proposal_drawing_file"/>
        <attributes>
            <basic name="drawingUrl">
                <column nullable="false" length="2500"/>
            </basic>
            <basic name="uploadStatus">
                <column name="upload_status" nullable="false"/>
                <enumerated>STRING</enumerated>
            </basic>

            <many-to-one name="proposal" fetch="LAZY">
                <join-column name="proposal_id" nullable="false"/>
            </many-to-one>
        </attributes>
    </entity>

</entity-mappings>
