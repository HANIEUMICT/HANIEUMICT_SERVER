<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.hibernate.org/xsd/orm/mapping
                                     https://hibernate.org/xsd/orm/mapping/mapping-3.1.0.xsd">
    <access>FIELD</access>

    <entity class="hanieum.conik.domain.project.entity.Project" access="FIELD">
        <table name="project"/>
        <attributes>
            <basic name="memberId">
                <column name="member_id" nullable="false"/>
            </basic>
            <basic name="projectTitle">
                <column name="project_title"/>
            </basic>
            <basic name="category">
                <column name="category"/>
            </basic>
            <basic name="categoryDetail">
                <column name="category_detail"/>
            </basic>
            <basic name="categoryDetailEtc">
                <column name="category_detail_etc"/>
            </basic>
            <basic name="purpose">
                <column name="purpose"/>
            </basic>
            <basic name="purposeEtc">
                <column name="purpose_etc"/>
            </basic>
            <basic name="projectQuantity">
                <column name="project_quantity"/>
            </basic>
            <basic name="requests">
                <column name="requests" column-definition="TEXT"/>
            </basic>
            <basic name="deadline">
                <column name="deadline"/>
            </basic>
            <basic name="canDeadlineChange">
                <column name="can_deadline_change"/>
            </basic>
            <basic name="requestEstimate">
                <column name="project_request_estimate"/>
            </basic>
            <basic name="publicUntil">
                <column name="project_public_until"/>
            </basic>
            <basic name="projectStatus">
                <column name="project_status"/>
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="canPhoneConsult">
                <column name="can_phone_consult"/>
            </basic>
            <basic name="deliveryAddress">
                <column name="delivery_address"/>
            </basic>
            <basic name="submitStatus">
                <column name="submit_status"/>
                <enumerated>STRING</enumerated>
            </basic>
        </attributes>
    </entity>
</entity-mappings>
