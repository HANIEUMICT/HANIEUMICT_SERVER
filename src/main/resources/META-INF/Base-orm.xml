<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.hibernate.org/xsd/orm/mapping
                                     https://hibernate.org/xsd/orm/mapping/mapping-3.1.0.xsd">
    <access>FIELD</access>

    <mapped-superclass class="hanieum.conik.domain.proposal.domain.entity.AbstractEntity">
        <attributes>
            <id name="id">
                <column name="id"/>
                <generated-value strategy="IDENTITY"/>
            </id>
        </attributes>
    </mapped-superclass>

    <entity class="hanieum.conik.domain.project.entity.Project" access="FIELD">
        <table name="project"/>
        <attributes>
            <basic name="userId">
                <column name="user_id" nullable="false"/>
            </basic>
            <basic name="projectTitle">
                <column name="project_title" nullable="false"/>
            </basic>
            <basic name="type">
                <column name="type" nullable="false"/>
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="category">
                <column name="category" nullable="false"/>
            </basic>
            <basic name="categoryService">
                <column name="category_service" nullable="false"/>
            </basic>
            <basic name="purpose">
                <column name="purpose" nullable="false"/>
            </basic>
            <basic name="purposeDetail">
                <column name="purpose_detail" nullable="false"/>
            </basic>
            <basic name="projectDrawing">
                <column name="drawing"/>
            </basic>
            <basic name="projectQuantity">
                <column name="project_quantity"/>
            </basic>
            <basic name="requests">
                <column name="requests" column-definition="TEXT"/>
            </basic>
            <basic name="deadline">
                <column name="deadline"/>
            </basic>
            <basic name="canDeadlineChange">
                <column name="can_deadline_change" nullable="false"/>
            </basic>
            <basic name="requestEstimate">
                <column name="project_request_estimate"/>
            </basic>
            <basic name="publicUntil">
                <column name="project_public_until"/>
            </basic>
            <basic name="projectStatus">
                <column name="project_status"/>
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="canPhoneConsult">
                <column name="can_phone_consult" nullable="false"/>
            </basic>
            <basic name="address">
                <column name="project_address" nullable="false"/>
            </basic>
        </attributes>
    </entity>

    <entity class="hanieum.conik.domain.proposal.domain.entity.Proposal" access="FIELD">
        <table name="proposal"/>
        <attributes>
            <basic name="projectId">
                <column name="project_id" nullable="false"/>
            </basic>
            <basic name="companyId">
                <column name="company_id" nullable="false"/>
            </basic>
            <basic name="totalPrice">
                <column name="total_price" nullable="false"/>
            </basic>
            <basic name="firstPrice">
                <column name="first_price"/>
            </basic>
            <basic name="secondPrice">
                <column name="second_price"/>
            </basic>
            <basic name="proposalDrawing">
                <column name="proposal_drawing"/>
            </basic>
            <basic name="proposalNote">
                <column name="proposal_note"/>
            </basic>

            <one-to-many name="items" mapped-by="proposal" orphan-removal="true">
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-many>
        </attributes>
    </entity>

    <entity class="hanieum.conik.domain.proposal.domain.entity.ProposalItem" access="FIELD">
        <table name="proposal_item"/>
        <attributes>
            <!-- 1. 연관관계 먼저 선언 -->
            <many-to-one name="proposal" fetch="LAZY">
                <join-column name="proposal_id" nullable="false"/>
            </many-to-one>

            <!-- 2. 그 다음 basic 필드들 선언 -->
            <basic name="itemName">
                <column name="item_name" nullable="false"/>
            </basic>
            <basic name="itemSize">
                <column name="item_size" nullable="false"/>
            </basic>
            <basic name="itemNote">
                <column name="item_note" nullable="false"/>
            </basic>
            <basic name="itemUnitPrice">
                <column name="item_unit_price" nullable="false"/>
            </basic>
            <basic name="itemQuantity">
                <column name="item_quantity" nullable="false"/>
            </basic>
        </attributes>
    </entity>
</entity-mappings>